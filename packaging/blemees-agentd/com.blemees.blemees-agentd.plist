<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.blemees.blemees-agentd</string>

    <!--
        launchd does not expand `~` or `$HOME` in StandardOutPath /
        StandardErrorPath, so a fixed path there would have to be shared
        (/tmp) or hard-coded per user. Instead, run the daemon through
        /bin/sh, which does expand $HOME (launchd sets it for a
        LaunchAgent), and send stdout + stderr to the per-user log:
            ~/Library/Logs/blemees-agentd.log
        `mkdir -p` makes the log dir first if it is missing (else the
        redirect fails before `exec`, with no trace anywhere).
        `exec` replaces the shell, so launchd tracks the daemon itself
        (KeepAlive and exit status work as before).
    -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>mkdir -p "$HOME/Library/Logs" &amp;&amp; exec blemees-agentd &gt;&gt; "$HOME/Library/Logs/blemees-agentd.log" 2&gt;&amp;1</string>
    </array>

    <!--
        If `blemees-agentd` or the ACP agent binaries (claude-agent-acp,
        codex-acp, ...) aren't on launchd's PATH, set PATH explicitly:
            <key>EnvironmentVariables</key>
            <dict>
                <key>PATH</key>
                <string>/Users/you/.local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
            </dict>
        Or give a profile's `agent_command` (or BLEMEES_AGENTD_AGENT for
        the default profile) as a full path.
    -->

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>ThrottleInterval</key>
    <integer>5</integer>
</dict>
</plist>
